# 域感智能 - 无人机数据管理系统配置
# 与仓库巡检系统共用 PostgreSQL 数据库

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warehouse_inspection
# 也可分别指定：
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=warehouse_inspection

SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 上传配置
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE=500000000  # 500MB
MAX_IMAGE_SIZE=50000000    # 50MB
