# 域感智能 - 生产环境配置模板
# 请复制此文件为 .env.prod 并修改为生产环境实际值

# JWT认证密钥（生产环境必须随机生成，禁止使用默认值）
# 生成命令：openssl rand -hex 32
JWT_SECRET_KEY=<请替换为随机生成的64字符密钥>

# 数据库连接（生产环境建议使用外部托管数据库）
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/warehouse_inspection

# Redis连接（生产环境建议使用外部托管Redis）
REDIS_URL=redis://redis:6379/0

# CORS配置（生产环境必须限制为实际域名）
# 示例：https://yourdomain.com,https://api.yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# 生产模式标志
DEBUG=false

# RFID硬件配置（根据实际设备路径配置）
RFID_DEVICE=/dev/ttyUSB0
RFID_BAUD_RATE=115200

# JWT配置
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 上传配置
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE=500000000  # 500MB
MAX_IMAGE_SIZE=50000000    # 50MB

# HTTPS配置（生产环境强制HTTPS）
# FORCE_HTTPS=true

# 日志级别（生产环境建议INFO或WARNING）
LOG_LEVEL=INFO