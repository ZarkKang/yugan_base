
# 域感智能 - 无人机数据管理系统配置
# Linux 环境配置示例

# 数据库配置 - 使用 SQLite（推荐用于开发
DATABASE_URL=sqlite:///./yugan.db
# 如需使用 PostgreSQL:
# DATABASE_URL=postgresql://yugan:yugan123@localhost:5432/yugan_db

# 安全配置
SECRET_KEY=change-this-in-production-to-a-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 上传配置
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE=500000000  # 500MB
MAX_IMAGE_SIZE=50000000    # 50MB

# Redis 配置（可选）
# REDIS_URL=redis://localhost:6379

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs
